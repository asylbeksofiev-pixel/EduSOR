# ---------------------------------------------------------------------------
# EduSOR — Конфигурация окружения (.env.example)
# Скопируйте в .env или .env.local и укажите ваш GEMINI_API_KEY.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# База данных:
#   local    — встроенная локальная БД SQLite (data/edusor.sqlite), работает сразу без Docker!
#   supabase — облачный или локальный Supabase Postgres + Auth + Storage
# ---------------------------------------------------------------------------
DATABASE_MODE=local
SESSION_SECRET=edusor-dev-session-secret-change-in-production-2026

# Заполните при DATABASE_MODE=supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Домен для входа учеников по логину без email
STUDENT_LOGIN_EMAIL_DOMAIN=students.edusor.local

# ---------------------------------------------------------------------------
# Google Gemini API (проверка СОР и СОЧ, распознавание сканов/фото работ, ИИ-тьютор)
# Получите ключ в Google AI Studio: https://aistudio.google.com/apikey
# Вставьте ваш ключ после знака "=" в строку GEMINI_API_KEY=
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash

# Опционально: резервный OpenAI-совместимый провайдер (если AI_PROVIDER=openai)
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_TEXT=gpt-4.1-mini
AI_MODEL_VISION=gpt-4.1-mini

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Секрет для фоновых задач (/api/jobs/run)
CRON_SECRET=change-me-to-a-long-random-string
