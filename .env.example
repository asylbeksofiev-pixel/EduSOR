# ---------------------------------------------------------------------------
# EduSOR environment variables. Copy to .env.local and fill in real values.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for auth redirects and invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser. Used by background jobs and admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain used to create sign-in emails for students who have no email address.
# Students sign in with their login; EduSOR maps it to <login>@<this domain>.
STUDENT_LOGIN_EMAIL_DOMAIN=students.edusor.local

# ---------------------------------------------------------------------------
# AI provider (any OpenAI-compatible Chat Completions API). Leave AI_API_KEY empty
# to run without AI: AI features then show as "unavailable" instead of failing silently.
# ---------------------------------------------------------------------------
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Model used for document structuring, grading and explanations (JSON output)
AI_MODEL_TEXT=gpt-4.1-mini
# Vision-capable model used for OCR of scanned pages and photos
AI_MODEL_VISION=gpt-4.1-mini
# Request timeout in milliseconds and number of retries for transient failures
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Secret for the background job endpoint (/api/jobs/run). Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
